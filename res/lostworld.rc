// Windows resources for LostWorld.exe: the application icon (Explorer, taskbar, title bar).
// The icon is generated from logo.png by tools/make_icon.py.
1 ICON "lostworld.ico"

// The version (lg_version.h, from the VERSION file): Properties > Details
#include "lg_version.h"
1 VERSIONINFO
FILEVERSION LG_VERSION_NUM
PRODUCTVERSION LG_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Lost World Native LG"
            VALUE "FileVersion", LG_VERSION
            VALUE "ProductName", "Lost World Native LG"
            VALUE "ProductVersion", LG_VERSION
            VALUE "OriginalFilename", "LostWorld.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
